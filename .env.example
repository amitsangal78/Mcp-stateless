# Copy to the monorepo root (every era loads this one file):
#   cp .env.example .env.local

# Cursor SDK — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# GitHub REST + GitHub MCP server
# Create a classic PAT with `repo` scope: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# Jira Cloud REST + Jira MCP server
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ENG
